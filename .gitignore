# Go 编译产物
/lopezpress
bin/
*.exe
*.test

# 数据目录（SQLite 文件 + 运行期产生的 uploads/logs/backups 全部在这里）
data/
*.db
*.sqlite
*.bak
*.bak-*

# 备份目录兜底（默认在 data/backups 下，已被 data/ 覆盖；此处防落到仓库根）
backups/
backups-diag/

# 环境变量
.env

# 前端（Preact + Vite + TS）
web/node_modules/
web/dist/
web/.vite/
vite.config.ts.timestamp-*

# IDE 与系统文件
.idea/
.vscode/
.DS_Store

# 运行时日志
*.log
backend.log
logs/

# 运行时上传目录（用户上传的图片等，不入库）
web/uploads/

# AI 工具临时态（交接文档已在根目录 .md 中版本化）
.workbuddy/

# 开发期自动生成的 JWT 签名密钥（config.EnsureJWTSecret 写入 data/.dev-jwt-secret）。
# 它是密钥，任何情况下都不许进仓库；生产环境不生成此文件，必须显式配置 JWT_SECRET。
.dev-jwt-secret
data/.dev-jwt-secret

# Python 缓存
__pycache__/
scripts/__pycache__/
