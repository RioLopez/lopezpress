# Go 编译产物
/lopezpress
bin/
*.test

# 数据目录（SQLite 文件 + 运行期产生的 uploads/logs/backups 全部在这里）
data/
*.db
*.sqlite
*.bak
*.bak-*

# 备份目录兜底（默认在 data/backups 下，已被 data/ 覆盖；此处防落到仓库根）
backups/
backups-diag/

# 环境变量
.env

# 前端（Preact + Vite + TS）
web/node_modules/
web/dist/
web/.vite/
vite.config.ts.timestamp-*

# Vditor 运行时资源：由 vite.config.ts 的 vditor-local-assets 插件在每次 dev/build
# 前从 node_modules 裁剪复制（24MB -> 4.7MB）。属生成物，改动由脚本决定，
# 入库只会让每次升级 vditor 都产生一堆二进制 diff。
web/public/vditor/

# IDE 与系统文件
.idea/
.vscode/
.DS_Store

# 运行时日志
*.log
backend.log
logs/

# 运行时上传目录（用户上传的图片等，不入库）
web/uploads/

# 本地工具临时态
.workbuddy/

# 开发期自动生成的 JWT 签名密钥（config.EnsureJWTSecret 写入 data/.dev-jwt-secret）。
# 它是密钥，任何情况下都不许进仓库；生产环境不生成此文件，必须显式配置 JWT_SECRET。
.dev-jwt-secret
data/.dev-jwt-secret

# Python 缓存
__pycache__/
scripts/__pycache__/

# 本地笔记与报告——仅本地，不随仓库分发
dev/
docs/

# 测试与内部演练脚本——仅本地保留，不随仓库分发。
# 公开仓库只放「能跑起来 / 能部署 / 能对接」所需的源码与配置；
# 测试里写满了内部字段名、错误文案与边界行为，等同把实现细节的说明书公开。
# 本地 go test / npm test 不受影响。
*_test.go
*.test.ts
scripts/truth_check.py
scripts/defence_smoke.py
scripts/backup_restore_drill.py
scripts/fakesmtp.py

# 个人上传工具的扫描白名单，与项目运行无关
.gau-allowlist
