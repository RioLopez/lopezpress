# LopezPress — production .env
# 部署到 VPS 时请替换 JWT_SECRET 为强随机串：
#   openssl rand -hex 32
# 其余参数按 1G / 1H / 5G VPS 的 70% 资源预算取值。

# ---- 服务（变量名与 config.Load 一致：PORT、DB_PATH）----
# 生产建议 127.0.0.1，让 Nginx 反代独占访问（多一层安全）
PORT=8080

# ---- 数据库（变量名与 config.Load 一致：DB_PATH）----
# SQLite 文件落在 /opt/lopezpress/data/（随 systemd WorkingDirectory）
DB_PATH=/opt/lopezpress/data/app.db

# ---- 鉴权 ----
# 必须替换！生产用 256-bit 随机密钥
JWT_SECRET=CHANGE_ME_TO_32_RANDOM_BYTES_HEX

# ---- 资源保护（1G 机器 70% 预算）----
# GORM 连接池：低配机收紧，避免 GORM 默认 32 连接吃内存
DB_MAX_OPEN=4
DB_MAX_IDLE=2
LOG_LEVEL=warn

# ---- 限流（每 key=用户ID或IP）----
# 默认 5 rps / burst 10（与 ARCHITECTURE.md §6 一致）
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
