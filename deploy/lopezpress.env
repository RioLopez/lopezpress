# LopezPress — production .env
# 部署到 VPS 时请替换 JWT_SECRET 为强随机串：
#   openssl rand -hex 32
# 其余参数按 1G / 1H / 5G VPS 的 70% 资源预算取值。

# ---- 服务（变量名与 config.Load 一致：HOST、PORT）----
# 线上实际端口是 8081（nginx 监听 8088 并反代到这里）。改端口时两边必须一起改，
# 只改一边的表现是外部 502，而服务本身 `systemctl status` 是 running。
PORT=8081

# 只监听回环：外部一律经 nginx 进入。绑 0.0.0.0 时任何一个误放行的
# 安全组/ufw 规则都会让扫描器绕过 nginx 直接打 Go——没有安全头、
# 没有点文件 deny、没有限速以外的一切保护。
HOST=127.0.0.1

# /health 不返回版本与 commit（匿名探针，公网上等于自报构建号）。
# 查版本：/opt/lopezpress/lopezpress -version
HEALTH_SHOW_VERSION=false

# ---- 数据库（变量名与 config.Load 一致：DB_PATH）----
# SQLite 文件落在 /opt/lopezpress/data/（随 systemd WorkingDirectory）
DB_PATH=/opt/lopezpress/data/app.db

# ---- 鉴权 ----
# 必须替换！生产用 256-bit 随机密钥
JWT_SECRET=CHANGE_ME_TO_32_RANDOM_BYTES_HEX

# ---- 资源保护（1G 机器 70% 预算）----
# GORM 连接池：低配机收紧，避免 GORM 默认 32 连接吃内存
DB_MAX_OPEN=4
DB_MAX_IDLE=2
LOG_LEVEL=warn

# ---- 限流（每 key=用户ID或IP）----
# 默认 5 rps / burst 10（与 ARCHITECTURE.md §6 一致）
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# ---- 登录验证码 ----
# 默认开启，且不建议关：注入式验证码的意义就在于不需要在出事前想起来打开。
# 只有一种：4 位字符图（去掉 0/O/1/I/l 等易混字符）。答案只存在服务端内存里，
# 响应只给图片；一次性使用、2 分钟过期、最多错 3 次、且绑定发起请求的客户端 IP，
# 所以抓包重放和"换个 IP 用别人解出的答案"都不成立。
# 验证码校验失败不计入账号锁定（否则 5 个空验证码就能把管理员锁死，比 5 次错密码更便宜），
# 但会让该 IP 的取图配额从 30 张/分钟收紧到 10 张/分钟。
CAPTCHA_ENABLED=true
