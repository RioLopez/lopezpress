# syntax=docker/dockerfile:1
#
# echo-content-api — API image: pure-Go static binary on distroless.
#
# The backend has zero CGO (glebarez/sqlite), so we can emit a fully static,
# stripped binary that runs on a ~2 MB distroless base with no libc. Build
# from the REPO ROOT so the root .dockerignore keeps the context lean:
#
#   docker build -f deploy/docker/Dockerfile.api -t echo-content-api/api ..
#
# Multi-arch: buildx exports TARGETOS/TARGETARCH; override with --platform.

FROM golang:1.22-alpine AS build
WORKDIR /src

# Dependency layer first (better caching when only source changes).
COPY go.mod go.sum ./
RUN go mod download

# Source. (.dockerignore strips node_modules, dist, data, *.db, secrets.)
COPY . .

# Static, stripped Linux binary. CGO disabled => no dynamic linking.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" \
    -o /out/echo-content-api ./cmd/server \
    && mkdir -p /data && chown -R 65532:65532 /data

# --- runtime: distroless static, non-root ---
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app
COPY --from=build --chown=65532:65532 /out/echo-content-api /app/echo-content-api
# Seed /data owned by the nonroot uid (65532) so a fresh named volume is writable.
COPY --from=build --chown=65532:65532 /data /data

# Runtime defaults (JWT_SECRET intentionally absent — must be supplied).
# Override via compose env_file / environment.
ENV PORT=8080 \
    DB_PATH=/data/app.db \
    UPLOAD_DIR=/data/uploads \
    DB_MAX_OPEN=4 \
    DB_MAX_IDLE=2 \
    LOG_LEVEL=warn \
    RATE_LIMIT_RPS=5 \
    RATE_LIMIT_BURST=10

EXPOSE 8080
VOLUME ["/data"]

USER nonroot
ENTRYPOINT ["/app/echo-content-api"]
