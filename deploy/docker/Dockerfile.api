# lopezpress — API image: pure-Go static binary (CGO-free) on minimal Alpine.
#
# The backend has zero CGO (glebarez/sqlite), so we emit a fully static,
# stripped binary. Runtime uses Alpine (Docker Hub only) which also ships CA
# certs so the optional outbound HTTPS (SM.MS upload) works. Build
# from the REPO ROOT so the root .dockerignore keeps the context lean:
#
#   docker build -f deploy/docker/Dockerfile.api -t lopezpress/api ..
#
# Multi-arch: buildx exports TARGETOS/TARGETARCH; override with --platform.

FROM golang:1.22-alpine AS build
WORKDIR /src

# Dependency layer first (better caching when only source changes).
COPY go.mod go.sum ./
RUN go mod download

# Source. (.dockerignore strips node_modules, dist, data, *.db, secrets.)
COPY . .

# Static, stripped Linux binary. CGO disabled => no dynamic linking.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" \
    -o /out/lopezpress ./cmd/server \
    && mkdir -p /data && chown -R 65532:65532 /data

# --- runtime: minimal Alpine, non-root (uid 65532); Docker Hub only ---
FROM alpine:3.20

WORKDIR /app
COPY --from=build --chown=65532:65532 /out/lopezpress /app/lopezpress
# Seed /data owned by the nonroot uid (65532) so a fresh named volume is writable.
COPY --from=build --chown=65532:65532 /data /data

# Runtime defaults (JWT_SECRET intentionally absent — must be supplied).
# Override via compose env_file / environment.
ENV PORT=8080 \
    DB_PATH=/data/app.db \
    UPLOAD_DIR=/data/uploads \
    DB_MAX_OPEN=4 \
    DB_MAX_IDLE=2 \
    LOG_LEVEL=warn \
    RATE_LIMIT_RPS=5 \
    RATE_LIMIT_BURST=10

EXPOSE 8080
VOLUME ["/data"]

USER 65532
ENTRYPOINT ["/app/lopezpress"]
