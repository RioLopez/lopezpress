# lopezpress — container .env (passed to the api service)
# Edit JWT_SECRET before first production boot:
#   openssl rand -hex 32

# ---- service ----
PORT=8080

# ---- database & uploads (persisted in the "api-data" named volume) ----
DB_PATH=/data/app.db
UPLOAD_DIR=/data/uploads

# ---- auth (REQUIRED in production) ----
# ⚠️ MUST be changed before the first `docker compose up`. The current value is
# intentionally weak so the app refuses to run in prod mode until you set a
# real one. Generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_BEFORE_FIRST_BOOT
# Optional: pin the first-boot admin password instead of the one-time banner.
# ADMIN_INITIAL_PASSWORD=

# ---- resource guards (1 vCPU / 1.5 GB VPS, ~70% budget) ----
DB_MAX_OPEN=4
DB_MAX_IDLE=2
LOG_LEVEL=warn

# ---- backup dumps (kept INSIDE the persistent volume, not the ephemeral /app) ----
BACKUP_DIR=/data/backups

# ---- production hardening (uncomment AFTER setting JWT_SECRET + CORS_ORIGINS) ----
# With APP_ENV=prod the app refuses to start unless JWT_SECRET is strong AND
# CORS_ORIGINS is an explicit origin list (never "*"). Until then it runs in
# dev mode (warnings only) which is fine for first-boot setup.
# APP_ENV=prod
# CORS_ORIGINS=http://your-domain-or-ip

# ---- rate limit (per identity = user id or IP) ----
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# ---- optional SM.MS image hosting (token held server-side) ----
# SM_MS_TOKEN=
