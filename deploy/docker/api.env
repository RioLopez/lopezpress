# echo-content-api — container .env (passed to the api service)
# Edit JWT_SECRET before first production boot:
#   openssl rand -hex 32

# ---- service ----
PORT=8080

# ---- database & uploads (persisted in the "api-data" named volume) ----
DB_PATH=/data/app.db
UPLOAD_DIR=/data/uploads

# ---- auth (REQUIRED in production) ----
JWT_SECRET=CHANGE_ME_TO_32_RANDOM_BYTES_HEX
# Optional: pin the first-boot admin password instead of the one-time banner.
# ADMIN_INITIAL_PASSWORD=

# ---- resource guards (1 vCPU / 1.5 GB VPS, ~70% budget) ----
DB_MAX_OPEN=4
DB_MAX_IDLE=2
LOG_LEVEL=warn

# ---- rate limit (per identity = user id or IP) ----
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# ---- optional SM.MS image hosting (token held server-side) ----
# SM_MS_TOKEN=
