# syntax=docker/dockerfile:1
#
# lopezpress — web image: Preact static dist + Nginx.
#
# Nginx serves the built SPA and reverse-proxies /api, /health and /uploads to
# the "api" service. Build from the REPO ROOT:
#
#   docker build -f deploy/docker/Dockerfile.web -t lopezpress/web ..

FROM node:22-alpine AS build
WORKDIR /src

# Reproducible install from the lockfile.
COPY web/package.json web/package-lock.json ./
RUN npm ci

# Build the SPA -> /src/dist (vite.config.ts sets build.outDir = "dist").
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
# Compose-aware vhost (upstream "api:8080", SPA fallback, gzip, /uploads proxy).
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80
