# 运行时端口
PORT=8080

# 监听地址。默认 127.0.0.1：本项目的部署形态是 nginx 与 Go 同机，
# 外部只该通过 nginx 进来。绑 0.0.0.0 时，只要端口对公网可达（安全组放行、
# ufw 放行、容器 -p 发布），扫描器就能绕过 nginx 直接和 Go 对话，
# 也就绕过了 nginx 的全部安全头与 deny 规则。
# Docker 或多机部署时显式改成 0.0.0.0。
HOST=127.0.0.1

# GET /health 是否返回版本号与 commit。默认 false：
# 该探针是匿名接口，公网上等于「免费告知对方我跑的是哪个构建」。
# 查版本用 `lopezpress -version`（ssh）或启动日志；只有私有环境里
# 负载均衡需要在 HTTP 上读版本时才开。
HEALTH_SHOW_VERSION=false

# 运行环境：dev（默认，仅校验时警告）| prod（严格校验：JWT_SECRET 必须 ≥32 字节且非默认值）
APP_ENV=dev

# JWT 密钥。生产环境务必配置为强随机字符串（长度 ≥ 32）。
# 留空时：
#   - dev：自动生成随机密钥并缓存到 data/.dev-jwt-secret（重启不登出）
#   - prod：拒绝启动（不用临时密钥，否则每次重启全员登出）
# 生成方法：openssl rand -base64 32  或  docker run --rm alpine:3.20 openssl rand -base64 32
JWT_SECRET=

# JWT 有效期（小时）
JWT_EXPIRY_HOURS=24

# SQLite 数据库文件路径（相对于项目根目录）
DB_PATH=data/app.db

# ---------- 低配 VPS（1 vCPU / 1.5 GB / 5 GB，封顶 70%）调优 ----------
# GORM 连接池上限（SQLite 单文件，池越大越浪费内存；默认 4/2 即可）
DB_MAX_OPEN=4
DB_MAX_IDLE=2

# GORM 日志级别：debug | info | warn | error（默认 warn，低配机降噪）
LOG_LEVEL=warn

# 令牌桶限流（每个身份 key 每秒请求数 / 突发上限，默认 20 / 50）
# 通用 GET/管理端点放宽到 20/50，避免单用户后台页面挂载时一批并行请求被 429；
# 登录爆破仍由独立 LoginLimiter（IP/账号双桶 + 失败锁）把守，放宽通用桶不构成绕过。
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=50

# 上传目录（图片上传落盘位置，相对于项目根目录；默认 data/uploads）
UPLOAD_DIR=data/uploads

# 单文件上传上限（字节，默认 2097152 = 2 MB）
UPLOAD_MAX_BYTES=2097152

# 备份导出目录（JSON 备份落盘位置，相对于项目根目录；默认 data/backups）
BACKUP_DIR=data/backups

# 首次启动 admin 账号的初始密码（可选）
# - 留空：程序自动生成 22 字符随机密码，仅在本进程的标准错误流打印一次（不落日志文件）
# - 填值：使用你指定的字符串（必须 ≥8 字符，含大小写 + 数字 + 特殊字符中至少两类）
# - 已有 admin 账号时不生效（不覆盖已存在的密码）
ADMIN_INITIAL_PASSWORD=

# CORS 允许的来源（逗号分隔；默认 "*" 仅适合本地开发）
# - dev：留空或 "*"，允许任意源（不携带 credentials）
# - prod：必须改为显式来源列表，如 https://blog.example.com
#         多来源用逗号分隔：https://blog.example.com,https://admin.example.com
# 详细安全说明见 docs/decisions/0004-cors.md
CORS_ORIGINS=*

# SM.MS 图床 token（spec #7：token 改由服务端持有，浏览器不再明文存放）
# - 留空：/api/upload 回退到站点设置里的 img_host_token（兼容旧配置）
# - 填值：使用该 token 代理上传到 https://sm.ms/api/v2/upload
# - 启用 smms 模式但未配置任何 token 时，/api/upload 返回 503，
#   提示管理员先配置，避免静默落到本地存储
SM_MS_TOKEN=
